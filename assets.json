    "left":   { "type": "frames", "frames": ["assets/monster/Left-1.png", "assets/monster/Left-2.png", "assets/monster/Left-3.png"], "fps": 3, "loop": true, "emoji": "👾" },
    "right":  { "type": "frames", "frames": ["assets/monster/Right-1.png", "assets/monster/Right-2.png", "assets/monster/right_2.png"], "fps": 6, "loop": true, "emoji": "👾" },
    "attack": { "type": "frames", "frames": ["assets/monster/Attak-1.png", "assets/monster/Attack-2.png"], "fps": 2, "loop": false, "emoji": "👹" }
  },

  "bomb": {
    "idle":      { "type": "frames", "frames": ["assets/bomb/Bomb - frame 01.png", "assets/bomb/Bomb - frame 02.png", "assets/bomb/Bomb - frame 03.png", "assets/bomb/Bomb - frame 04.png", "assets/bomb/Bomb - frame 05.png", "assets/bomb/Bomb - frame 06.png", "assets/bomb/Bomb - frame 07.png", "assets/bomb/Bomb - frame 08.png"], "fps": 1, "loop": false, "emoji": "💣" },
    "explosion": { "type": "frames", "frames": ["assets/effects/explosion/1.png", "assets/effects/explosion/2.png", "assets/effects/explosion/3.png", "assets/effects/explosion/4.png", "assets/effects/explosion/5.png", "assets/effects/explosion/6.png", "assets/effects/explosion/7.png", "assets/effects/explosion/8.png", "assets/effects/explosion/9.png"], "fps": 9, "loop": false, "emoji": "💥" }
  },

  "box": {
    "intact":    { "type": "image", "src": "assets/environment/Tile - Box.png", "emoji": null }
  },

  "reward": { "type": "frames", "frames": ["assets/reward/Tile - Chest.png"], "fps": 1, "loop": false, "emoji": "🎁" },

  "safePoint": {
    "idle": { "type": "image", "src": "assets/environment/Tile - Safe Point.png", "emoji": "🛡️" }
  },

  "deco": {
    "tree":    { "type": "image", "src": "assets/environment/Tile - Obstacle 01.png", "emoji": "🌲" },
    "bush 01":    { "type": "image", "src": "assets/environment/Tile - Obstacle 02.png", "emoji": "🏮" },
    "bush 02":    { "type": "image", "src": "assets/environment/Tile - Obstacle 03.png", "emoji": "🏮" },
    "snowman 01": { "type": "image", "src": "assets/environment/Tile - Obstacle 04.png", "emoji": "⛄" },
    "snowman 02": { "type": "image", "src": "assets/environment/Tile - Obstacle 05.png", "emoji": "⛄" }
  },

  "tileOverlays": {
    "_note": "Selectable/selected/path-preview/blocked tile-frame art. If 'src' is set and the image loads, it is drawn as a border/frame overlay on top of the tile (replacing the built-in CSS highlight for that state); leave 'src' null to keep the current CSS-only look. 'selectable' is the tile a player can currently click/hover to move to.",
    "selectable": { "type": "image", "src": null, "emoji": null },
    "selected": { "type": "image", "src": null, "emoji": null },
    "pathPreview": { "type": "image", "src": null, "emoji": null },
    "blocked": { "type": "image", "src": null, "emoji": null }
  }
}
