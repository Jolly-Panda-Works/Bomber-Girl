{
  "_comment": "Centralized asset configuration for Bomber Girl. Every gameplay object resolves its look-and-feel from here. Each entry is either {type:'frames', frames:[...], fps, loop, emoji} for animated sprites, or {type:'image', src, emoji} for a static image, or {type:'emoji', emoji} when no art exists yet. 'emoji' is always present as the fallback if the referenced file(s) fail to load. Paths are relative to this file's parent folder (i.e. relative to game_assets/).",
  "tileSize": { "width": 32, "height": 32, "note": "source tile size from the asset sheet; scale in-engine as needed" },

  "tile": {
    "_note": "Base look of a normal walkable board tile (used for both the 'snow' and 'floor' tile kinds). If 'src' is set and the image loads, it replaces the default CSS ice-gradient tile background; leave 'src' null to keep the current default look.",
    "empty": { "type": "image", "src": "assets/environment/Empty Tile.png", "emoji": null }
  },

  "player": {
    "idle":  { "type": "frames", "frames": ["assets/player/idle/01.png", "assets/player/idle/02.png", "assets/player/idle/03.png", "assets/player/idle/04.png", "assets/player/idle/05.png", "assets/player/idle/06.png"], "fps": 6, "loop": true, "emoji": "🧑‍🚀" },
    "up":    { "type": "frames", "frames": ["assets/player/move-up/01.png", "assets/player/move-up/02.png", "assets/player/move-up/03.png", "assets/player/move-up/04.png", "assets/player/move-up/05.png"], "fps": 5, "loop": true, "emoji": "🧑‍🚀" },
    "down":  { "type": "frames", "frames": ["assets/player/move-down/1.png", "assets/player/move-down/2.png", "assets/player/move-down/3.png", "assets/player/move-down/4.png", "assets/player/move-down/5.png", "assets/player/move-down/6.png", "assets/player/move-down/7.png"], "fps": 7, "loop": true, "emoji": "🧑‍🚀" },
    "left":  { "type": "frames", "frames": ["assets/player/move-left/01.png", "assets/player/move-left/02.png", "assets/player/move-left/03.png", "assets/player/move-left/04.png", "assets/player/move-left/05.png", "assets/player/move-left/06.png"], "fps": 6, "loop": true, "emoji": "🧑‍🚀" },
    "right": { "type": "frames", "frames": ["assets/player/move-right/1.png", "assets/player/move-right/2.png", "assets/player/move-right/3.png", "assets/player/move-right/4.png", "assets/player/move-right/5.png", "assets/player/move-right/6.png"], "fps": 6, "loop": true, "emoji": "🧑‍🚀" },
    "die":   { "type": "frames", "frames": ["assets/player/die/1.png", "assets/player/die/2.png", "assets/player/die/3.png", "assets/player/die/4.png"], "fps": 4, "loop": false, "emoji": "💀" }
  },

  "avatars": [
    { "id": "cozy",      "label": "Cozy",      "type": "image", "src": "assets/avatar/1.png", "emoji": "🧑‍🎄" },
    { "id": "astronaut", "label": "Astronaut", "type": "image", "src": "assets/avatar/2.png", "emoji": "🧑‍🚀" },
    { "id": "ninja",     "label": "Ninja",     "type": "image", "src": "assets/avatar/3.png", "emoji": "🥷" },
    { "id": "wizard",    "label": "Wizard",    "type": "image", "src": "assets/avatar/4.png", "emoji": "🧙‍♀️" },
    { "id": "hero",      "label": "Hero",      "type": "image", "src": "assets/avatar/5.png", "emoji": "🦸‍♀️" },
    { "id": "snowpal",   "label": "Snow Pal",  "type": "image", "src": "assets/avatar/6.png", "emoji": "⛄" }
  ],

  "monster": {
    "idle":   { "type": "frames", "frames": ["assets/monster/Idle-1.png", "assets/monster/Idle-2.png"], "fps": 2, "loop": true, "emoji": "👾" },
